# EverUs / DateMate Environment Variables
# Copy this file to a new file named '.env' in the same folder and fill in the values below.

# Your Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous API Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
